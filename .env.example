# .env.example - Пример конфигурации (скопируйте в .env и заполните)

# ==================== Telegram Bot ====================
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789
ADMIN_USERNAME=@username

# ==================== 3x-ui Panel ====================
XUI_URL=https://your-server.com:48531/your-secret-path
XUI_USERNAME=admin
XUI_PASSWORD=your_password
INBOUND_ID=1
XUI_DB_PATH=/etc/x-ui/x-ui.db
API_TIMEOUT=30

# ==================== VPN Server ====================
SERVER_ADDRESS=your-server.com
SERVER_PORT=443
SECURITY=tls
SNI=yahoo.com
FINGERPRINT=chrome

# ==================== Reality (опционально) ====================
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=

# ==================== Лимиты ====================
MAX_TRAFFIC_GB=1000
MAX_DAYS=365
MIN_DAYS=1
DEFAULT_TRAFFIC_GB=100
DEFAULT_DAYS=30

# ==================== База данных ====================
DB_PATH=/app/data/bot_users.db
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL=24

# ==================== Логирование ====================
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs/bot.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5
