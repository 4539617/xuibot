# .env - Пример конфигурации замените на свои данные
# ==================== Telegram Bot ====================
BOT_TOKEN=0123456789:54jb6jk4h6b4jh36b4-dfg7dfg7dfg66dfg
ADMIN_IDS=123456789
ADMIN_USERNAME=@username

# ==================== 3x-ui Panel ====================
XUI_URL=https://localhost:12345/gf8h7fghdfg7hdf7hfg7h8fg7h
XUI_USERNAME=login
XUI_PASSWORD=password
INBOUND_ID=1
XUI_DB_PATH=/etc/x-ui/x-ui.db
API_TIMEOUT=30

# ==================== VPN Server ====================
SERVER_ADDRESS=123.45.67.89
SERVER_PORT=443

# ==================== Транспорт и безопасность ====================
# Тип транспорта: tcp, xhttp
TRANSPORT=xhttp

# Тип безопасности: tls, reality
SECURITY=reality

# ==================== TLS (если SECURITY=tls) ====================
TLS_SNI=123.45.67.89
TLS_FINGERPRINT=firefox

# ==================== Reality (если SECURITY=reality) ====================
REALITY_SNI=google.com
REALITY_FINGERPRINT=firefox
REALITY_PUBLIC_KEY=Gsd7ff7s8d-gdffg77f6-b-jdku_7sdkjfBHB7ek
REALITY_SHORT_ID=8g579dy

# ==================== xHTTP (если TRANSPORT=xhttp) ====================
XHTTP_MODE=auto

# ==================== Лимиты ====================
MAX_TRAFFIC_GB=1000
MAX_DAYS=3650
MIN_DAYS=1
DEFAULT_TRAFFIC_GB=100
DEFAULT_DAYS=30

# ==================== База данных ====================
DB_PATH=/app/data/bot_users.db
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL=24

# ==================== Логирование ====================
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs/bot.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5
